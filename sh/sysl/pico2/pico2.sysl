// The Raspberry Pi Pico 2 W, as sysl rather than as C.
//
// **This package declares and does not implement.** Every name it rests on is a symbol the pico-sdk
// already has, so no C is carried here and there is nothing for a linker to be pointed at — which is
// what makes it different in kind from the org's other bindings. A program importing this must be
// built by `sysl build-c` and linked into a CMake project that has the SDK. A plain `sysl build` will
// compile it and then fail to link, naming `sleep_us`, and the fault will be the build rather than
// the code.
//
// **The C surface is next door in `sh.sysl.pico2.externs`, and this module is written in terms of
// it.** That is the whole shape: `externs` is faithful to the header, this one is pleasant to use,
// and the translation between them happens in one place where it can be read. The name is plural
// because `extern` is a reserved word and cannot be a module path segment. What gets translated is
// C-isms — an `int` that is really a byte, an `int` that is really a failure, a pin that is really
// the LED, two functions that are really one idea in two units.
//
// **Nothing here can be tested off the target.** There are no `@test` functions because there is
// nothing a host could run: every function ends in a call to a board.

module sh.sysl.pico2

import sh.sysl.pico2.externs as lib
import sysl.buf.{Buf, buf}
import sysl.text.{cstring, str_builder}
import sysl.time.{Duration, millis, whole_micros, whole_millis}

// ## The board
//
// `CYW43_WL_GPIO_LED_PIN`, from `boards/pico2_w.h`. **A board fact and not a chip fact** — the LED is
// wired to the wireless chip on a Pico 2 W, and a plain Pico 2 puts it on an ordinary RP2350 pin.
const led_pin: uint = 0

// `CYW43_WL_GPIO_SMPS_PIN` — drives the switched-mode supply into PWM mode, trading efficiency at low
// load for less ripple.
const smps_pin: uint = 1

// `CYW43_WL_GPIO_VBUS_PIN` — reads whether USB power is present.
const vbus_pin: uint = 2

// ## Starting up
//
// Bring the board up: stdio first, so that a failure in the second half has somewhere to be reported.
//
// **Answers whether the wireless chip started**, where C answers non-zero on failure. A caller that
// only wants the LED still has to check it, because the LED is on that chip.
init() -> bool =
    lib.stdio_init_all()
    lib.cyw43_arch_init() == 0

// Whether a host has opened the USB serial port.
//
// **A board prints into nowhere until this is true** — the SDK discards stdio output with no host
// attached, so a banner written at startup is simply lost and the program looks dead rather than
// early.
terminal_connected() -> bool = lib.stdio_usb_connected()

// Block until a host opens the USB serial port, so that what is printed next is seen.
wait_for_terminal() =
    while !terminal_connected()
        sleep(millis(50))

// ## Waiting
//
// **One function, where C has two.** `sleep_ms` and `sleep_us` are C's two spellings for one idea,
// and carrying both would have been this module failing at its job — a caller saying which unit it
// happens to be thinking in is the C-ism, and `sysl.time` already has a type for a length of time.
//
// It goes to `sleep_us` for either, since a `Duration` is microseconds inside and the SDK's
// millisecond form is the same wait with a multiply in front of it.
sleep(d: Duration) = lib.sleep_us(u64(whole_micros(d)))

// ## The LED and the supply

led(on: bool) = lib.cyw43_arch_gpio_put(led_pin, on)

led_is_on() -> bool = lib.cyw43_arch_gpio_get(led_pin)

// Whether the board is running on USB power rather than on its own supply.
on_usb_power() -> bool = lib.cyw43_arch_gpio_get(vbus_pin)

// ## Wi-Fi
//
// **A program using any of this must link one of the `pico_cyw43_arch_lwip_*` CMake targets**, not
// the `pico_cyw43_arch_none` that a blinking LED gets away with. Joining waits for the link to come
// *up*, and "up" is a question only lwIP can answer — the driver reads it out of a `netif` — so with
// no TCP/IP stack linked the radio associates and nothing is ever able to say so. There are two:
//
// - **`..._lwip_threadsafe_background`** drives the driver from an interrupt, so a program that
//   blocks somewhere else keeps its connection alive while it waits. A program built around
//   `read_line` wants this one.
// - **`..._lwip_poll`** does nothing until `poll` is called, which is cheaper and entirely wrong for
//   a program that blocks on input.
//
// **A DHCP lease is part of joining.** `join` answers when the board has an address rather than when
// the radio associated, so success here is a usable connection and not a promising start.

// How a network authenticates.
//
// The names are the protocol's rather than the SDK's. `CYW43_AUTH_WPA2_AES_PSK` spells out a cipher
// and a key type as well, and since exactly one of each is on offer per protocol, those extra words
// distinguish nothing and only make the common case long.
enum Auth
    Open
    Wpa
    Wpa2
    WpaWpa2
    Wpa3
    Wpa2Wpa3

// `CYW43_AUTH_*` from `cyw43_ll.h`, transcribed the way the pin numbers above are.
//
// **Transcribing these is safe where transcribing a struct would not be** (`15 §7`): each is a
// documented protocol constant that the driver's own API takes as a plain `uint32_t`, so nothing
// here depends on a layout a compiler chose or on an option somebody else set.
private auth_code(a: Auth) -> u32 =
    a match
        Open -> 0
        Wpa -> 0x00200002
        Wpa2 -> 0x00400004
        WpaWpa2 -> 0x00400006
        Wpa3 -> 0x01000004
        Wpa2Wpa3 -> 0x01400004

// Why a join did not happen.
//
// **`TimedOut` is also what a network that is not there looks like**, and that is the SDK's doing
// rather than a simplification made here: it turns "no matching SSID" into another attempt and keeps
// retrying until the clock runs out, so the outcome never reaches a caller. A wrong SSID and a
// router that is switched off are the same answer, and no arrangement of this type could separate
// them.
//
// `Refused` carries a code the join never got far enough to interpret — the request itself was
// rejected before the radio began.
enum JoinError
    BadPassword
    TimedOut
    Failed
    Refused(code: int)

// The rendering, so that a failed join can be reported without matching on it.
impl Display for JoinError
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            BadPassword -> "the password was refused"
            TimedOut -> "no answer — wrong name, out of range, or switched off"
            Failed -> "the network refused the connection"
            Refused(code) -> s"the radio would not start the join (error $code)"

        display_str(text, out, fmt)
    end display

// Join a network, returning once the board has an address.
//
// The station interface is enabled here rather than by a separate call the caller has to remember,
// because there is nothing else to do with it: every path to a join goes through it.
join(ssid: string, password: string, auth: Auth, timeout: Duration) -> Result[unit, JoinError] =
    val name = cstring(ssid)
    val secret = cstring(password)

    lib.cyw43_arch_enable_sta_mode()

    joined(lib.cyw43_arch_wifi_connect_timeout_ms(
        name.ptr, secret.ptr, auth_code(auth), u32(whole_millis(timeout))))

// Join a network that has no password.
//
// **A null password is how C says this**, and passing an empty string instead does not mean the same
// thing — so the distinction gets a function rather than an `Option` the caller fills in with `None`
// nine times out of ten.
join_open(ssid: string, timeout: Duration) -> Result[unit, JoinError] =
    val name = cstring(ssid)

    lib.cyw43_arch_enable_sta_mode()

    joined(lib.cyw43_arch_wifi_connect_timeout_ms(
        name.ptr, null, auth_code(Open), u32(whole_millis(timeout))))

// The SDK's `pico_error_codes`, which are not the `CYW43_LINK_*` values the same function's
// documentation describes — it translates them on the way out, and `-2` arrives meaning a timeout
// where `CYW43_LINK_NONET` uses the same number for something else entirely.
private joined(rc: int) -> Result[unit, JoinError] =
    if rc == 0 then Ok(())
    else if rc == -2 then Err(TimedOut)
    else if rc == -7 then Err(BadPassword)
    else if rc == -8 then Err(Failed)
    else Err(Refused(rc))

// Leave the network and shut the station interface down.
leave() = lib.cyw43_arch_disable_sta_mode()

// Become an access point, so that something else can join *this* board.
//
// **Nothing here hands out addresses.** A phone will associate and then wait for a DHCP lease that
// is not coming, which looks like a network that connects and does not work. Serving one is lwIP's
// job and this package does not reach that far yet.
access_point(ssid: string, password: string, auth: Auth) =
    val name = cstring(ssid)
    val secret = cstring(password)

    lib.cyw43_arch_enable_ap_mode(name.ptr, secret.ptr, auth_code(auth))

close_access_point() = lib.cyw43_arch_disable_ap_mode()

// The two-letter country the radio is configured for — `XX` when it is the worldwide default.
//
// `CYW43_COUNTRY(a, b, rev)` packs two ASCII letters into the low bytes and a revision above them,
// and the revision is dropped here: it selects a regulatory table and says nothing a caller asking
// which country would want.
country() -> string =
    val packed = lib.cyw43_arch_get_country_code()
    var out = str_builder()

    out.push_char(char(uint(packed & 0xFF)))
    out.push_char(char(uint((packed >> 8) & 0xFF)))
    out.finish()

// Give the driver a chance to run.
//
// **Only `..._lwip_poll` needs this**, and under the background variant it does nothing — which is
// what makes it safe to call from a loop that does not know which one it was linked against.
poll() = lib.cyw43_arch_poll()

// ## Bytes and characters, in and out
//
// **Both exist, and the difference is not pedantry.** A `char` is a Unicode scalar value and may take
// four bytes on the wire; a byte is a byte. Text wants characters. Echoing a line as it is typed
// wants bytes, because a byte pulled out of a half-typed line is not a character yet — and C's
// `getchar`, which answers a *byte* in something named for a character, is exactly the confusion this
// module is here to undo.
//
// **`None` at end of input, where C answers `-1` in the same `int` it uses for the byte.** That is
// the other C-ism worth removing: a caller writing `if c < 0` is writing C, and a caller matching on
// `None` is writing sysl.
read_byte() -> Option[u8] =
    val c = lib.stdio_getchar()

    if c < 0 then None else Some(u8(c))

write_byte(b: u8) = lib.putchar(int(b))

// One character, encoded as UTF-8 — **which is a different thing from one byte, and the reason both
// exist.** A `char` is a Unicode scalar value, so writing one may put up to four bytes on the wire;
// `write_byte` puts exactly the byte it is given. Text wants the first, and echoing what arrived on a
// serial port wants the second, because a byte pulled out of a half-typed line is not a character
// yet.
//
// The encoding is `sysl.printc`'s, which ends at the same `putchar` this module declares.
write_char(c: char) = printc(c)

// One character, decoded from however many bytes it took — the other half of `write_char`, and the
// one a program reading text wants.
//
// **`None` means the input ended**, not that something was wrong with it. Malformed input answers
// **U+FFFD**, the replacement character, which is what a terminal does and what keeps one bad byte
// from ending a session. A caller that needs to tell a bad byte from a good one reads bytes.
//
// A continuation byte that is missing or out of range ends the character there and answers the
// replacement, rather than consuming what follows: the next byte is far more likely to start a fresh
// character than to be the rest of a broken one.
read_char() -> Option[char] =
    read_byte() match
        None -> None

        Some(b0) ->
            if b0 < 128 then return Some(char(uint(b0)))

            var more = 0

            if b0 & 224 == 192 then more = 1
            else if b0 & 240 == 224 then more = 2
            else if b0 & 248 == 240 then more = 3

            // A continuation byte arriving where a leading byte belongs.
            if more == 0 then return Some(replacement)

            val mask = if more == 1 then 31 else if more == 2 then 15 else 7
            var cp = uint(b0 & u8(mask))
            var n = 0

            while n < more
                read_byte() match
                    None -> return Some(replacement)

                    Some(b) ->
                        if b & 192 != 128 then return Some(replacement)

                        cp = (cp << 6) | uint(b & 63)
                        n += 1

            Some(char(cp))
end read_char

// ## A line of input

// U+FFFD, what a decoder answers for input it cannot make sense of.
private const replacement: char = '\u{FFFD}'

// Whether the last line ended with a CR, so that the LF of a CRLF is swallowed rather than read as an
// empty line following it. It has to outlive one `read_line`, because the two bytes of a CRLF
// straddle the boundary between one line and the next.
private var saw_cr: bool = false

// One line of input, without its terminator — **echoed as it is typed**.
//
// **This exists because a serial terminal is neither a file nor a shell.** Two things a hosted
// program never thinks about are missing, and each makes a REPL look broken in its own way:
//
// *Line endings.* The standard library's line cursor splits on `\n`, which is right for a pipe and
// wrong for a console: `screen` sends a bare `\r` when Enter is pressed, so a program reading lines
// that way waits forever. `sysl.io` says so in its own documentation now, and points here. CR, LF and
// CRLF all end a line.
//
// *Echo.* A terminal on the other end of a USB CDC port has no line discipline, so nothing appears as
// it is typed and there is no way to correct a mistake. Backspace and delete both rub a character
// out, and Enter echoes CRLF so that what the program prints next starts on a line of its own.
//
// The line grows as it is typed rather than being bounded by a size the caller had to guess, which is
// worth an allocator on this board: the SDK links newlib, so there is a heap whether or not this
// package uses one.
//
// **It answers a `string` and cannot fail**, which it could not do while the line was held as bytes.
// A `Buf[char]` is valid text by construction — every element came out of `read_char`, which is where
// a malformed byte already became U+FFFD — so there is nothing left to validate at the end and no
// `Result` for the caller to unwrap.
read_line() -> string =
    var line: Buf[char] = buf()
    var at: usize = 0

    loop
        read_byte() match
            None -> return finish(&line)

            Some(b) ->
                if b == u8('\r')
                    // CR ends the line. Whether an LF follows is not known yet, so it is remembered
                    // rather than waited for: a terminal sending bare CR would never send one, and
                    // waiting would hang until the next keystroke.
                    saw_cr = true
                    at = to_end(&line, at)
                    new_line()
                    return finish(&line)
                else if b == u8('\n')
                    if saw_cr
                        saw_cr = false
                    else
                        at = to_end(&line, at)
                        new_line()
                        return finish(&line)
                else
                    saw_cr = false
                    at = edit(&line, at, b)
end read_line

// The characters gathered back into a `string`, which is one `StrBuilder` and no validation.
private finish(line: *Buf[char]) -> string =
    var out = str_builder()

    for c in line.view()
        out.push_char(c)

    out.finish()

// One keystroke's worth of editing, answering where the cursor ended up.
//
// Split out because `read_line` above is about *when a line ends*, and this is about what the line
// says — two questions that were one function until arrow keys arrived, at which point the function
// stopped fitting on a screen twice over.
//
// A byte that begins a character is read the rest of the way here rather than in `read_line`, so
// that what goes into the line is always a whole character.
private edit(line: *Buf[char], at: usize, b: u8) -> usize =
    if b == 27
        escape(line, at)
    else if b == 8 || b == 127
        backspace(line, at)
    else if b == 1
        to_start(line, at)                  // Ctrl-A
    else if b == 5
        to_end(line, at)                    // Ctrl-E
    else if b == 2
        left(line, at)                      // Ctrl-B
    else if b == 6
        right(line, at)                     // Ctrl-F
    else if b == 21
        kill_line(line, at)                 // Ctrl-U
    else if b == 11
        kill_to_end(line, at)               // Ctrl-K
    else if b >= 32
        insert(line, at, from_byte(b))
    else
        // Any other control character would move the terminal's cursor without being in the line.
        at
end edit

// The character a byte begins, read the rest of the way off the port.
//
// It is `read_char`'s decode with the lead byte already in hand, which is the shape a line editor
// needs: the loop above has to look at every byte to find the control keys, so by the time it knows
// the byte is ordinary text it has already taken it.
private from_byte(b0: u8) -> char =
    if b0 < 128 then return char(uint(b0))

    var more = 0

    if b0 & 224 == 192 then more = 1
    else if b0 & 240 == 224 then more = 2
    else if b0 & 248 == 240 then more = 3

    // A continuation byte arriving where a leading byte belongs.
    if more == 0 then return replacement

    val mask = if more == 1 then 31 else if more == 2 then 15 else 7
    var cp = uint(b0 & u8(mask))
    var n = 0

    while n < more
        read_byte() match
            None -> return replacement

            Some(b) ->
                if b & 192 != 128 then return replacement

                cp = (cp << 6) | uint(b & 63)
                n += 1

    char(cp)
end from_byte

// An escape sequence, of which only `ESC [ …` is understood.
//
// **The bytes of a sequence arrive together**, so reading them with the same blocking call the rest
// of the loop uses is safe in practice. A lone Escape key is the exception: it waits for the next
// keystroke before deciding, which is what every terminal program does and for the same reason.
private escape(line: *Buf[char], at: usize) -> usize =
    read_byte() match
        None -> at

        Some(bracket) ->
            if bracket != u8('[') then return at

            read_byte() match
                None -> at

                Some(c) ->
                    if c == u8('D') then left(line, at)
                    else if c == u8('C') then right(line, at)
                    else if c == u8('H') then to_start(line, at)
                    else if c == u8('F') then to_end(line, at)
                    else if c == u8('3')
                        // Delete arrives as `ESC [ 3 ~`, so the tilde has to be taken as well.
                        read_byte()
                        delete_at(line, at)
                    else
                        // Up, down, and everything else with a longer form: swallowed rather than
                        // echoed, since echoing it would move the cursor off the line.
                        at
end escape

// ### Moving
//
// The cursor is moved by writing rather than by an escape sequence: a backspace goes left one, and
// re-echoing the character under the cursor goes right one. That needs no number formatting, and so
// no allocation per keystroke.
//
// **The line is a `Buf[char]`, so the cursor is an index into it and the arithmetic is `at - 1` and
// `at + 1`.** It was held as bytes until the standard library could turn characters back into text —
// `encode_utf8`, which `StrBuilder.push_char` goes through — and that cost sixty lines of walking
// UTF-8 boundaries by hand, in `left`, `right`, `backspace` and `delete_at` alike. None of it is here
// now, and one bad byte can no longer be half-erased, because a half character never enters the line.
//
// The one thing still assumed is that a character occupies **one column**. A wide character — CJK,
// most emoji — takes two, so erasing one leaves half of it behind. Getting that right means asking
// `sysl.text.columns` for a width and counting columns rather than characters, which is a further
// piece of work and is not done here.
private write_from(line: *Buf[char], from: usize) =
    var i = from

    while i < line.len()
        write_char(line.view()[i])
        i += 1

private left(line: *Buf[char], at: usize) -> usize =
    if at == 0 then return at

    write_char('\b')
    at - 1

private right(line: *Buf[char], at: usize) -> usize =
    if at >= line.len() then return at

    write_char(line.view()[at])
    at + 1

private to_start(line: *Buf[char], at: usize) -> usize =
    var i = at

    while i > 0
        write_char('\b')
        i -= 1

    0

private to_end(line: *Buf[char], at: usize) -> usize =
    write_from(line, at)
    line.len()

// ### Changing
//
// After an edit at `at`, everything to its right has moved, so the tail is written out again and the
// cursor walked back to where it belongs. `blanks` is how many columns to paint over — what the line
// no longer covers, one for a deletion and none for an insertion.
private redraw(line: *Buf[char], at: usize, blanks: usize) =
    write_from(line, at)

    var pad = blanks

    while pad > 0
        write_char(' ')
        pad -= 1

    var back = line.len() - at + blanks

    while back > 0
        write_char('\b')
        back -= 1
end redraw

private insert(line: *Buf[char], at: usize, c: char) -> usize =
    line.insert(at, c)
    write_char(c)
    redraw(line, at + 1, 0)
    at + 1

private backspace(line: *Buf[char], at: usize) -> usize =
    if at == 0 then return at

    line.remove(at - 1)
    write_char('\b')
    redraw(line, at - 1, 1)
    at - 1

private delete_at(line: *Buf[char], at: usize) -> usize =
    if at >= line.len() then return at

    line.remove(at)
    redraw(line, at, 1)
    at

// Ctrl-U — everything gone.
private kill_line(line: *Buf[char], at: usize) -> usize =
    val was = line.len()

    to_start(line, at)
    line.clear()
    redraw(line, 0, was)
    0

// Ctrl-K — everything from the cursor to the end.
private kill_to_end(line: *Buf[char], at: usize) -> usize =
    val dropped = line.len() - at

    line.truncate(at)
    redraw(line, at, dropped)
    at

private new_line() =
    write_char('\r')
    write_char('\n')
