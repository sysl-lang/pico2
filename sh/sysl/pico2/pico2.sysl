// The Raspberry Pi Pico 2 W, as sysl rather than as C.
//
// **Nearly every name it rests on is a symbol the pico-sdk already has**, so most of this package is
// declaration and there is nothing for a linker to be pointed at — which is what makes it different
// in kind from the org's other bindings. A program importing this must be built by `sysl build-c` and
// linked into a CMake project that has the SDK. A plain `sysl build` will compile it and then fail to
// link, naming `sleep_us`, and the fault will be the build rather than the code.
//
// **Four files here are C, and each says at length why it had to be**: `scan.c`, because the driver
// reports results to a callback in its own background context; `net.c`, because lwIP reaches into a
// `netif` with macros rather than functions; and `dns.c` and `http.c`, for the same callback reason
// as the scan. Everything else is a signature.
//
// **`http.c` also needs the CMake project to have linked mbedtls**, which is the one place this
// package's requirements reach past the SDK's Wi-Fi support. Without it the file compiles to
// refusals and `fetch` answers `Unsupported`, so a program that does not want TLS pays nothing.
//
// **The C surface is next door in `sh.sysl.pico2.externs`, and this module is written in terms of
// it.** That is the whole shape: `externs` is faithful to the header, this one is pleasant to use,
// and the translation between them happens in one place where it can be read. The name is plural
// because `extern` is a reserved word and cannot be a module path segment. What gets translated is
// C-isms — an `int` that is really a byte, an `int` that is really a failure, a pin that is really
// the LED, two functions that are really one idea in two units.
//
// **Nothing here can be tested off the target.** There are no `@test` functions because there is
// nothing a host could run: every function ends in a call to a board.

module sh.sysl.pico2

import sh.sysl.pico2.externs as lib
import sysl.buf.{Buf, buf}
import sysl.io.Reader
import sysl.text.{Search, cstring, from_cstring, parse_int, str_builder}
import sysl.time.{Duration, DurationUnits, whole_micros, whole_millis}

// ## The board
//
// `CYW43_WL_GPIO_LED_PIN`, from `boards/pico2_w.h`. **A board fact and not a chip fact** — the LED is
// wired to the wireless chip on a Pico 2 W, and a plain Pico 2 puts it on an ordinary RP2350 pin.
const led_pin: uint = 0

// `CYW43_WL_GPIO_SMPS_PIN` — drives the switched-mode supply into PWM mode, trading efficiency at low
// load for less ripple.
const smps_pin: uint = 1

// `CYW43_WL_GPIO_VBUS_PIN` — reads whether USB power is present.
const vbus_pin: uint = 2

// ## Starting up
//
// Bring the board up: stdio first, so that a failure in the second half has somewhere to be reported.
//
// **Answers whether the wireless chip started**, where C answers non-zero on failure. A caller that
// only wants the LED still has to check it, because the LED is on that chip.
init() -> bool =
    lib.stdio_init_all()
    lib.cyw43_arch_init() == 0

// Whether a host has opened the USB serial port.
//
// **A board prints into nowhere until this is true** — the SDK discards stdio output with no host
// attached, so a banner written at startup is simply lost and the program looks dead rather than
// early.
terminal_connected() -> bool = lib.stdio_usb_connected()

// Block until a host opens the USB serial port, so that what is printed next is seen.
wait_for_terminal() =
    while !terminal_connected()
        sleep(50.ms)

// ## Waiting
//
// **One function, where C has two.** `sleep_ms` and `sleep_us` are C's two spellings for one idea,
// and carrying both would have been this module failing at its job — a caller saying which unit it
// happens to be thinking in is the C-ism, and `sysl.time` already has a type for a length of time.
//
// It goes to `sleep_us` for either, since a `Duration` is microseconds inside and the SDK's
// millisecond form is the same wait with a multiply in front of it.
sleep(d: Duration) = lib.sleep_us(u64(whole_micros(d)))

// ## The LED and the supply

led(on: bool) = lib.cyw43_arch_gpio_put(led_pin, on)

led_is_on() -> bool = lib.cyw43_arch_gpio_get(led_pin)

// Whether the board is running on USB power rather than on its own supply.
on_usb_power() -> bool = lib.cyw43_arch_gpio_get(vbus_pin)

// ## Wi-Fi
//
// **A program using any of this must link one of the `pico_cyw43_arch_lwip_*` CMake targets**, not
// the `pico_cyw43_arch_none` that a blinking LED gets away with. Joining waits for the link to come
// *up*, and "up" is a question only lwIP can answer — the driver reads it out of a `netif` — so with
// no TCP/IP stack linked the radio associates and nothing is ever able to say so. There are two:
//
// - **`..._lwip_threadsafe_background`** drives the driver from an interrupt, so a program that
//   blocks somewhere else keeps its connection alive while it waits. A console built on `ConsoleIn`
//   wants this one: it spends nearly all its life blocked on a keystroke.
// - **`..._lwip_poll`** does nothing until `poll` is called, which is cheaper and entirely wrong for
//   a program that blocks on input.
//
// **A DHCP lease is part of joining.** `join` answers when the board has an address rather than when
// the radio associated, so success here is a usable connection and not a promising start.

// How a network authenticates.
//
// The names are the protocol's rather than the SDK's. `CYW43_AUTH_WPA2_AES_PSK` spells out a cipher
// and a key type as well, and since exactly one of each is on offer per protocol, those extra words
// distinguish nothing and only make the common case long.
enum Auth
    Open
    Wpa
    Wpa2
    WpaWpa2
    Wpa3
    Wpa2Wpa3

// `CYW43_AUTH_*` from `cyw43_ll.h`, transcribed the way the pin numbers above are.
//
// **Transcribing these is safe where transcribing a struct would not be** (`15 §7`): each is a
// documented protocol constant that the driver's own API takes as a plain `uint32_t`, so nothing
// here depends on a layout a compiler chose or on an option somebody else set.
private auth_code(a: Auth) -> u32 =
    a match
        Open -> 0
        Wpa -> 0x00200002
        Wpa2 -> 0x00400004
        WpaWpa2 -> 0x00400006
        Wpa3 -> 0x01000004
        Wpa2Wpa3 -> 0x01400004

// Why a join did not happen.
//
// **`TimedOut` is also what a network that is not there looks like**, and that is the SDK's doing
// rather than a simplification made here: it turns "no matching SSID" into another attempt and keeps
// retrying until the clock runs out, so the outcome never reaches a caller. A wrong SSID and a
// router that is switched off are the same answer, and no arrangement of this type could separate
// them.
//
// `Refused` carries a code the join never got far enough to interpret — the request itself was
// rejected before the radio began.
enum JoinError
    BadPassword
    TimedOut
    Failed
    Refused(code: int)

// The rendering, so that a failed join can be reported without matching on it.
impl Display for JoinError
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            BadPassword -> "the password was refused"
            TimedOut -> "no answer — wrong name, out of range, or switched off"
            Failed -> "the network refused the connection"
            Refused(code) -> s"the radio would not start the join (error $code)"

        display_str(text, out, fmt)
    end display

// Join a network, returning once the board has an address.
//
// The station interface is enabled here rather than by a separate call the caller has to remember.
// `scan` enables it too and for the same reason -- the interface is a precondition of using the
// radio as a station at all, rather than of joining, and this comment used to say "there is nothing
// else to do with it", which is how `scan` came to be written without it.
join(ssid: string, password: string, auth: Auth, timeout: Duration) -> Result[unit, JoinError] =
    val name = cstring(ssid)
    val secret = cstring(password)

    lib.cyw43_arch_enable_sta_mode()

    joined(lib.cyw43_arch_wifi_connect_timeout_ms(
        name.ptr, secret.ptr, auth_code(auth), u32(whole_millis(timeout))))

// Join a network that has no password.
//
// **A null password is how C says this**, and passing an empty string instead does not mean the same
// thing — so the distinction gets a function rather than an `Option` the caller fills in with `None`
// nine times out of ten.
join_open(ssid: string, timeout: Duration) -> Result[unit, JoinError] =
    val name = cstring(ssid)

    lib.cyw43_arch_enable_sta_mode()

    joined(lib.cyw43_arch_wifi_connect_timeout_ms(
        name.ptr, null, auth_code(Open), u32(whole_millis(timeout))))

// The SDK's `pico_error_codes`, which are not the `CYW43_LINK_*` values the same function's
// documentation describes — it translates them on the way out, and `-2` arrives meaning a timeout
// where `CYW43_LINK_NONET` uses the same number for something else entirely.
private joined(rc: int) -> Result[unit, JoinError] =
    if rc == 0 then Ok(())
    else if rc == -2 then Err(TimedOut)
    else if rc == -7 then Err(BadPassword)
    else if rc == -8 then Err(Failed)
    else Err(Refused(rc))

// Leave the network and shut the station interface down.
leave() = lib.cyw43_arch_disable_sta_mode()

// ## Where the board is on the network
//
// **The first part of this package that reads lwIP rather than the driver**, and what turns a
// successful `join` from a claim into a number somebody can ping. It rests on `net.c` for the reason
// scanning rests on `scan.c`: an address is a field of a `struct netif` that is itself a field of a
// driver global, and lwIP reaches into it with macros rather than functions, so there is no symbol
// here for sysl to declare.
//
// **A program linked against `pico_cyw43_arch_none` gets `Down` and no address**, always. That is
// not this package giving up — the interface those answers would come from is not compiled into the
// driver at all in such a build, and a board with no TCP/IP stack genuinely has nowhere to put an
// address.

// An IPv4 address, as the four numbers it is written as.
struct Ipv4
    a: u8
    b: u8
    c: u8
    d: u8

// So that an address can be printed without taking it apart.
impl Display for Ipv4
    display(self, out: *Writer, fmt: FormatSpec)
        display_str(s"${self.a}.${self.b}.${self.c}.${self.d}", out, fmt)
    end display

// How far along the station connection is.
//
// **`NoAddress` covers two of the driver's states** — `CYW43_LINK_JOIN` and `CYW43_LINK_NOIP` — which
// differ over whether lwIP has finished bringing the interface up. That is a distinction inside the
// stack and not one a caller can act on: both mean the radio has associated and there is still
// nothing to talk from.
//
// `Failed` carries the driver's own negative code — `-1` the connection failed, `-2` no such network,
// `-3` the password was refused. **`join` reports all three better than this can**, having been there
// when it happened; they reach here only when something asks after the fact.
//
// **`JoinError` above names a `Failed` too, and that is fine**: a variant belongs to its enum rather
// than to the module, so the two coexist and each use site is settled by the type expected there —
// the return type below, and the scrutinee in the rendering.
enum Link
    Down
    NoAddress
    Up
    Failed(code: int)

impl Display for Link
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            Down -> "down"
            NoAddress -> "associated, with no address yet"
            Up -> "up"
            Failed(code) -> s"failed (error $code)"

        display_str(text, out, fmt)
    end display

link() -> Link =
    val rc = lib.link_status()

    if rc == 3 then Up
    else if rc == 1 || rc == 2 then NoAddress
    else if rc == 0 then Down
    else Failed(rc)

// The board's own address, once DHCP has handed one over.
//
// **`None` is also what a board that never joined says**, and `link` is what tells the two apart:
// `NoAddress` is a lease still coming, `Down` is nothing to have leased it.
ip() -> Option[Ipv4] = address(lib.ip4_address())

// The netmask that came with the address.
netmask() -> Option[Ipv4] = address(lib.ip4_netmask())

// The router that everything not on this network goes through.
gateway() -> Option[Ipv4] = address(lib.ip4_gateway())

// **The octets arrive packed high to low**, `a.b.c.d` as `0xAABBCCDD`, because lwIP stores an address
// in network byte order and `net.c` is where that stops being a question.
//
// Zero is how an interface with no address reads, and there is no host it could be naming, so it
// becomes `None` rather than a printable `0.0.0.0` that a caller would have to know to distrust.
private address(packed: u32) -> Option[Ipv4] =
    if packed == 0 then return None

    Some(Ipv4(
        u8((packed >> 24) & 0xFF),
        u8((packed >> 16) & 0xFF),
        u8((packed >> 8) & 0xFF),
        u8(packed & 0xFF)))

// ## Names
//
// **The first thing here that uses the connection rather than describing it.** Everything above
// answers questions about the radio and the interface; this one sends a packet to a server the DHCP
// lease named and waits for a reply.
//
// It rests on `dns.c` for a reason the two files above did not have: lwIP hands the answer to a
// callback running in its own interrupt context, so the result is collected in C and read back here.

// Why a name did not resolve.
//
// **`NotFound` is also what an unreachable server looks like.** lwIP retries and then reports failure
// with no address, and the API says nothing about which kind of failure it was — so a name that does
// not exist and a network with no working DNS server arrive here identically. That is the resolver's
// doing and not a simplification made here.
//
// `TimedOut` is this module's own patience running out, which is rarer than it sounds: lwIP gives up
// after about five seconds of its own and calls back, so a longer budget than that will almost always
// see `NotFound` first. It is here for the case where the stack never answers at all.
//
// `Refused` means the query never went out — no server configured, or a name lwIP would not accept.
enum ResolveError
    NotFound
    TimedOut
    Refused(code: int)

impl Display for ResolveError
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            NotFound -> "no such name, or no server that would say"
            TimedOut -> "the resolver never answered"
            Refused(code) -> s"the query could not be sent (error $code)"

        display_str(text, out, fmt)
    end display

// The address a name stands for.
//
// **One address, even where a name has several.** Anything a browser would visit answers with a
// handful of A records, and lwIP keeps the first and discards the rest before this could see them —
// so this is *an* address for the name rather than *the* address, and asking twice inside the TTL
// gives the same one from the cache.
//
// **A dotted quad resolves to itself** without a packet leaving the board, which makes this safe to
// call on input that might already be an address.
//
// **This blocks for up to `patience`**, polling at ten hertz, for the reason `scan` does: there is
// nothing to wait on, only a flag the callback sets. A join has to have happened first — with no
// lease there is no server to ask, and the answer is `Refused`.
resolve(name: string, patience: Duration) -> Result[Ipv4, ResolveError] =
    val wanted = cstring(name)
    val rc = lib.dns_start(wanted.ptr)

    if rc < 0 then return Err(Refused(rc))

    // Tenths of the budget, counted down, since there is no clock reading here to compare against.
    var left = whole_millis(patience) / 100

    while lib.dns_busy() && left > 0
        sleep(100.ms)
        left -= 1

    if !lib.dns_found()
        if lib.dns_busy() then return Err(TimedOut)

        return Err(NotFound)

    address(lib.dns_address()) match
        Some(a) -> Ok(a)

        // The resolver said it had an address and the address is `0.0.0.0`, which no name should
        // stand for. Reporting it as a miss is better than handing back an address that goes nowhere.
        None -> Err(NotFound)
end resolve

// ## Fetching a document
//
// **This is the connection being used for something, rather than described or probed.** It rests on
// `http.c`, which puts lwIP's own HTTP client behind a start-poll-read surface — and on mbedtls,
// linked in by the CMake project rather than by anything here, for the `https` half.
//
// **One request at a time.** The body and the host name are single pieces of storage in the shim, so
// a second `fetch` while one is in flight is refused rather than allowed to overwrite the first.

// What came back.
//
// **`status` is a separate question from whether the fetch worked**: a `404` that arrives whole is a
// successful fetch of an error page, and is reported as `Ok` with a status of 404. A caller that
// cares looks at the number.
struct Response
    status: u32
    body: string
    // Whether the body was longer than there was room for. A short answer that reads as the whole
    // document is the one outcome worth ruling out.
    truncated: bool

// Why a fetch did not happen.
//
// **`Untrusted` is the one worth reading twice.** The board carries two certificate authorities and
// nothing else, so a perfectly good server whose chain ends anywhere else is refused. That is the
// design working rather than failing — with verification required, a name this board cannot check is
// a name it will not talk to.
//
// **A refused certificate is not distinguished from any other failure to connect**, because lwIP's
// client reports both as one code. `Untrusted` and `Unreachable` are therefore the same answer
// wearing two names, and only one of them is produced; the enum keeps both so that a future client
// that can tell them apart does not change this type.
enum FetchError
    BadUrl
    Busy
    Unsupported
    Unresolved
    Unreachable
    Untrusted
    Closed
    TimedOut
    OutOfMemory
    Refused(code: int)

impl Display for FetchError
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            BadUrl -> "that is not an http or https URL"
            Busy -> "a fetch is already running"
            Unsupported -> "this build has no http client in it"
            Unresolved -> "the host name could not be resolved"
            Unreachable -> "could not connect — unreachable, or a certificate this board does not trust"
            Untrusted -> "the certificate was not signed by an authority this board carries"
            Closed -> "the server closed the connection early"
            TimedOut -> "the server did not answer in time"
            OutOfMemory -> "not enough memory for the transfer"
            Refused(code) -> s"the request could not be sent (error $code)"

        display_str(text, out, fmt)
    end display

// Fetch a document over http or https.
//
// **The scheme is the only difference, and it costs one field.** lwIP's client opens its connection
// through an allocator; given none it speaks plain TCP, and given the TLS one it speaks https. So
// both come out of one binary and one path through this function.
//
// **This blocks for up to `patience`**, polling at ten hertz, as `scan` and `resolve` do. A TLS
// handshake on this board takes a second or two, so a budget under about five seconds will report a
// working server as slow.
//
// A join has to have happened first: with no lease there is no name resolution and the answer is
// `Unresolved`.
fetch(url: string, patience: Duration) -> Result[Response, FetchError] =
    val taken = split_url(url)

    if taken.is_none() then return Err(BadUrl)

    val parts = taken.unwrap()
    val host = cstring(parts.host)
    val path = cstring(parts.path)
    val rc = lib.http_start(host.ptr, parts.port, path.ptr, parts.secure)

    if rc == -100 then return Err(Busy)
    if rc == -103 then return Err(Unsupported)
    if rc < 0 then return Err(Refused(rc))

    // Tenths of the budget, counted down, since there is no clock reading here to compare against.
    var left = whole_millis(patience) / 100

    while lib.http_busy() && left > 0
        sleep(100.ms)
        left -= 1

    if lib.http_busy() then return Err(TimedOut)

    val outcome = lib.http_outcome()

    if outcome != 0 then return Err(failure(outcome))

    Ok(Response(
        lib.http_status(),
        from_cstring(lib.http_body()).unwrap_or("(a body that is not UTF-8)"),
        lib.http_truncated()))
end fetch

// `httpc_result_t` as something a caller can match on.
private failure(code: int) -> FetchError =
    if code == 2 then Unreachable
    else if code == 3 then Unresolved
    else if code == 4 then Closed
    else if code == 5 then TimedOut
    else if code == 7 then OutOfMemory
    else Refused(code)

// A URL taken apart far enough to ask for it.
private struct Url
    host: string
    port: u16
    path: string
    secure: bool

// **Only `http` and `https` with a host, and that is the whole grammar.** No credentials, no
// fragment, and a query string is simply part of the path — which is what the wire wants anyway,
// since the request line carries everything after the host verbatim.
private split_url(url: string) -> Option[Url] =
    var secure = true
    var rest = ""

    if url.starts_with("https://")
        rest = url[8..]
    else if url.starts_with("http://")
        secure = false
        rest = url[7..]
    else
        return None

    // Everything to the first slash names the host; what follows is asked for as it stands. A URL
    // with no path at all is asking for the root.
    val cut = rest.index_of("/")
    val authority = cut match
        Some(at) -> rest[..<at]
        None -> rest

    val path = cut match
        Some(at) -> rest[at..]
        None -> "/"

    if authority.is_empty() then return None

    // A port after a colon, and the scheme's own when there is none.
    authority.index_of(":") match
        None -> Some(Url(authority, if secure then 443 else 80, path, secure))

        Some(at) ->
            val digits = authority[at + 1..]
            val host = authority[..<at]

            if host.is_empty() then return None

            parse_int(digits) match
                Ok(n) if n > 0 && n <= 65535 -> Some(Url(host, u16(n), path, secure))
                _ -> None
end split_url

// Become an access point, so that something else can join *this* board.
//
// **Nothing here hands out addresses.** A phone will associate and then wait for a DHCP lease that
// is not coming, which looks like a network that connects and does not work. Serving one is lwIP's
// job and this package does not reach that far yet.
access_point(ssid: string, password: string, auth: Auth) =
    val name = cstring(ssid)
    val secret = cstring(password)

    lib.cyw43_arch_enable_ap_mode(name.ptr, secret.ptr, auth_code(auth))

close_access_point() = lib.cyw43_arch_disable_ap_mode()

// The two-letter country the radio is configured for — `XX` when it is the worldwide default.
//
// `CYW43_COUNTRY(a, b, rev)` packs two ASCII letters into the low bytes and a revision above them,
// and the revision is dropped here: it selects a regulatory table and says nothing a caller asking
// which country would want.
country() -> string =
    val packed = lib.cyw43_arch_get_country_code()
    var out = str_builder()

    out.push_char(char(uint(packed & 0xFF)))
    out.push_char(char(uint((packed >> 8) & 0xFF)))
    out.finish()

// Give the driver a chance to run.
//
// **Only `..._lwip_poll` needs this**, and under the background variant it does nothing — which is
// what makes it safe to call from a loop that does not know which one it was linked against.
poll() = lib.cyw43_arch_poll()

// ## Scanning
//
// **This is the one part of the package with C behind it** — `scan.c`, which says why at length. The
// short version is that the driver hands its results to a callback running in *its* background
// context, and a sysl callback there would allocate inside an interrupt.

// One network the radio can see.
struct Network
    ssid: string
    // Signal strength in dBm, so it is negative and closer to zero is stronger. Around -50 is the
    // same room; below -80 is unlikely to join.
    rssi: int
    channel: int
    // **The driver's own small code, and NOT one of the `Auth` values above.** A scan reports
    // authentication in a single byte with an encoding of its own, unrelated to the 32-bit
    // `CYW43_AUTH_*` constants that `join` takes. It is passed through as a number rather than
    // dressed up as an `Auth` it is not: `0` is an open network and the rest are best left to a
    // caller that has the driver's source open.
    auth_code: int

// Every network the radio can hear, strongest sighting of each.
//
// **This blocks for up to `patience`.** A scan has no completion callback — the only way to know it
// has finished is to watch `scan_busy` go false — so this polls at ten hertz and gives up when the
// budget runs out. Two or three seconds is usually plenty.
//
// Duplicates are already gone: an access point answers once per probe, so the raw results hold a
// dozen copies of every network. Hidden networks are dropped, having no name to list.
//
// An empty answer means the scan could not be started or nothing replied — the two are not
// distinguished, because a caller can do the same thing about either.
scan(patience: Duration) -> []Network =
    var out: Buf[Network] = buf()

    // **The station interface has to be up to scan**, and this is the second path that needs it. It
    // is enabled here for the reason `join` enables it there -- there is nothing a caller could
    // usefully do with a separate call except forget it -- and enabling it twice is harmless.
    //
    // Leaving this out is not a failure that announces itself: the driver starts a scan that finds
    // nothing, so a board surrounded by networks reports an empty list. Verified on hardware
    // 2026-08-09, where `list` on a freshly booted board saw **nothing** and the same command after
    // a *failed* join -- which enables the interface on its way past -- saw ten networks.
    lib.cyw43_arch_enable_sta_mode()

    if lib.scan_start() != 0 then return out.view()

    // Tenths of the budget, counted down, since there is no clock reading here to compare against.
    var left = whole_millis(patience) / 100

    while lib.scan_busy() && left > 0
        sleep(100.ms)
        left -= 1

    for i in 0..<lib.scan_count()
        out.push(Network(ssid_at(i), lib.scan_rssi(i), lib.scan_channel(i), lib.scan_auth(i)))

    out.view()

// Whether the last scan saw more networks than it had room for, so that a truncated list is not
// mistaken for a complete one.
scan_was_truncated() -> bool = lib.scan_overflowed()

// **An SSID is bytes and not text.** Nothing requires it to be UTF-8, and a network named in some
// other encoding is a real thing rather than a corruption — so it gets a placeholder that can be
// printed instead of an error the caller would have to unwrap on every entry.
private ssid_at(i: int) -> string =
    from_cstring(lib.scan_ssid(i)).unwrap_or("(a name that is not UTF-8)")

// ## Bytes and characters, in and out
//
// **Both exist, and the difference is not pedantry.** A `char` is a Unicode scalar value and may take
// four bytes on the wire; a byte is a byte. Text wants characters. Echoing a line as it is typed
// wants bytes, because a byte pulled out of a half-typed line is not a character yet — and C's
// `getchar`, which answers a *byte* in something named for a character, is exactly the confusion this
// module is here to undo.
//
// **`None` at end of input, where C answers `-1` in the same `int` it uses for the byte.** That is
// the other C-ism worth removing: a caller writing `if c < 0` is writing C, and a caller matching on
// `None` is writing sysl.
read_byte() -> Option[u8] =
    val c = lib.stdio_getchar()

    if c < 0 then None else Some(u8(c))

write_byte(b: u8) = lib.putchar(int(b))

// One character, encoded as UTF-8 — **which is a different thing from one byte, and the reason both
// exist.** A `char` is a Unicode scalar value, so writing one may put up to four bytes on the wire;
// `write_byte` puts exactly the byte it is given. Text wants the first, and echoing what arrived on a
// serial port wants the second, because a byte pulled out of a half-typed line is not a character
// yet.
//
// The encoding is `sysl.printc`'s, which ends at the same `putchar` this module declares.
write_char(c: char) = printc(c)

// ## The port as a `Reader` and a `Writer`
//
// **This is the whole of what the package supplies to a line editor, and it used to supply the editor
// as well.** `read_line` lived here — some two hundred lines of insertion, backspace, arrow keys and
// redraw arithmetic — because `sysl.io` had no answer for a terminal with no line discipline. It has
// one now: `sysl.term.edit`, which is the same editor over a `*Reader` and a `*Writer`, so a board and
// a desktop run the same code and only these two types differ.
//
// The other thing that changed is that the editor can be **tested**. Wired straight to
// `stdio_getchar`, it could only be exercised by a person typing at a serial cable, which is why the
// package README called the absence of tests its real weakness. Over a `Reader` it is ordinary code,
// and the redraw arithmetic — the part most worth checking and least visible — is now checked by the
// compiler's own suite.
//
// **Two types rather than one implementing both**, so an editor is handed two distinct borrows rather
// than two mutable borrows of one value. Neither carries state: the port is the board's, not the
// value's, so both are empty structs exactly as `sysl.io`'s `Stdout` and `Stderr` are.

// The USB serial port, read a byte at a time.
//
// **One byte per read is honest rather than lazy.** `stdio_getchar` blocks until a byte arrives and
// cannot say how many are waiting, so filling more of the caller's slice would mean waiting for input
// that may never be typed. A cursor over this refills as often as it must, which is what its own
// buffer is for.
struct ConsoleIn
end ConsoleIn

impl Fallible for ConsoleIn

impl Reader for ConsoleIn
    read(*self, into: []u8) -> []const u8
        if into.len == 0 then return into

        read_byte() match
            None -> into[0..<0]

            Some(b) ->
                into[0] = b
                into[0..<1]
    end read
end ConsoleIn

// The same port, written to.
//
// It needs no flushing, which is the one place a board is simpler than a host: the SDK's `putchar`
// puts bytes on the wire rather than into a buffer, so what an editor echoes appears as it is typed
// without anybody asking. `sysl.term.tty.tty_writer` exists because a hosted C library does not.
struct ConsoleOut
end ConsoleOut

impl Fallible for ConsoleOut

impl Writer for ConsoleOut
    write(*self, bytes: []const u8)
        for b in bytes do write_byte(b)
end ConsoleOut

console_in() -> ConsoleIn = ConsoleIn()

console_out() -> ConsoleOut = ConsoleOut()

// One character, decoded from however many bytes it took — the other half of `write_char`, and the
// one a program reading text wants.
//
// **`None` means the input ended**, not that something was wrong with it. Malformed input answers
// **U+FFFD**, the replacement character, which is what a terminal does and what keeps one bad byte
// from ending a session. A caller that needs to tell a bad byte from a good one reads bytes.
//
// A continuation byte that is missing or out of range ends the character there and answers the
// replacement, rather than consuming what follows: the next byte is far more likely to start a fresh
// character than to be the rest of a broken one.
read_char() -> Option[char] =
    read_byte() match
        None -> None

        Some(b0) ->
            if b0 < 128 then return Some(char(uint(b0)))

            var more = 0

            if b0 & 224 == 192 then more = 1
            else if b0 & 240 == 224 then more = 2
            else if b0 & 248 == 240 then more = 3

            // A continuation byte arriving where a leading byte belongs.
            if more == 0 then return Some(replacement)

            val mask = if more == 1 then 31 else if more == 2 then 15 else 7
            var cp = uint(b0 & u8(mask))
            var n = 0

            while n < more
                read_byte() match
                    None -> return Some(replacement)

                    Some(b) ->
                        if b & 192 != 128 then return Some(replacement)

                        cp = (cp << 6) | uint(b & 63)
                        n += 1

            Some(char(cp))
end read_char

// U+FFFD, what a decoder answers for input it cannot make sense of.
private const replacement: char = '\u{FFFD}'

// ## Reading a line — which is `sysl.term.edit`'s job now, and used to be this file's
//
// **`read_line` is gone, and about two hundred lines with it.** It was a full line editor —
// insertion, backspace, delete, arrow keys, Home and End, Ctrl-A/E/B/F/U/K and the redraw arithmetic
// under all of it — and it lived here for one reason: a USB CDC port has no line discipline, and
// nothing in the standard library would supply one.
//
// `sysl.term.edit` is that editor, over a `*Reader` and a `*Writer`. A program on this board now
// writes what a program at a desktop terminal writes, and the two differ only in where the bytes
// come from:
//
//     import sysl.term.edit.editor
//
//     var input = console_in()
//     var output = console_out()
//     var ed = editor(&input, &output)
//
//     for line in ed
//         ...
//
// **Three things came back that could not be had here**, each a real defect rather than a missing
// nicety. A character is measured in *columns*, so erasing a CJK character or an emoji no longer
// leaves half of it on the screen. An arrow key is understood in both spellings a terminal sends —
// this file read only `ESC [ …`, and a terminal in application cursor key mode sends `ESC O …`, which
// arrived as stray letters in the line. And the whole of it is **tested**, against a byte script
// rather than a person at a cable, which is what the README called this package's real weakness.
