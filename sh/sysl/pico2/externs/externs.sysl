// The pico-sdk's own surface, declared verbatim.
//
// **Nothing here is meant to be called by a program.** Every name, every type and every convention is
// C's: an error is a non-zero `int`, a byte is an `int` so that `-1` can mean failure, and a pin is a
// bare number. The module beside this one turns those into sysl and is what an application imports.
//
// The split is worth the file because it keeps two jobs apart. This one has to be *faithful* — a
// signature that disagrees with the C header links perfectly and corrupts the call at run time, and
// nothing in this arrangement checks one against the other, so each declaration below was read out of
// the header named above it rather than remembered. The other one has to be *pleasant*, which is a
// different question and would otherwise be answered in the same breath.
//
// It also means both modules may use a name: `sleep_ms` here is C's, and `sleep_ms` next door is
// sysl's, and neither has to be renamed to avoid the other.

module sh.sysl.pico2.externs

// ## `pico/stdio.h`

// Brings up whichever stdio the CMake build selected — `pico_enable_stdio_usb` for the USB serial
// port, `pico_enable_stdio_uart` for the pins.
extern "stdio_init_all" stdio_init_all() -> bool

// One byte of input, blocking until there is one. **`PICO_ERROR_TIMEOUT` (-1) on failure**, which is
// why the answer is an `int` and not a byte.
extern "stdio_getchar" stdio_getchar() -> int

// ## `pico/stdio_usb.h`

// Whether a host has opened the USB serial port. The SDK discards stdio output while this is false.
extern "stdio_usb_connected" stdio_usb_connected() -> bool

// ## `pico/time.h`

extern "sleep_ms" sleep_ms(ms: u32)

extern "sleep_us" sleep_us(us: u64)

// ## `pico/cyw43_arch.h`

// **Non-zero on failure**, C-style, rather than truthy on success.
extern "cyw43_arch_init" cyw43_arch_init() -> int

extern "cyw43_arch_deinit" cyw43_arch_deinit()

// A GPIO belonging to the CYW43439 rather than to the RP2350, so `gpio_put` cannot reach it.
extern "cyw43_arch_gpio_put" cyw43_arch_gpio_put(wl_gpio: uint, on: bool)

extern "cyw43_arch_gpio_get" cyw43_arch_gpio_get(wl_gpio: uint) -> bool

// ### Station mode
//
// **These need `pico_cyw43_arch_lwip_*` on the link line, not `pico_cyw43_arch_none`.** The join
// below waits for `CYW43_LINK_UP`, which `cyw43_tcpip_link_status` reads out of an lwIP `netif` —
// so with no TCP/IP stack linked there is nothing that can report the link ever coming up. The
// module beside this one says which variant and why.

extern "cyw43_arch_enable_sta_mode" cyw43_arch_enable_sta_mode()

extern "cyw43_arch_disable_sta_mode" cyw43_arch_disable_sta_mode()

// **Zero on success, and otherwise one of the `CYW43_LINK_*` negatives** — `-1` failed, `-2` no
// such network, `-3` bad authentication — or `PICO_ERROR_TIMEOUT` (`-1`) when the timeout expires
// first. That the two share `-1` is C's, and is undone next door.
//
// `pw` may be null for an open network, which is `none` on the sysl side.
extern "cyw43_arch_wifi_connect_timeout_ms" cyw43_arch_wifi_connect_timeout_ms(
    ssid: *u8, pw: *u8, auth: u32, timeout_ms: u32) -> int

// Starts the join and returns immediately. **Zero means the request was sent**, not that the
// network was joined.
extern "cyw43_arch_wifi_connect_async" cyw43_arch_wifi_connect_async(
    ssid: *u8, pw: *u8, auth: u32) -> int

// ### Access-point mode

extern "cyw43_arch_enable_ap_mode" cyw43_arch_enable_ap_mode(ssid: *u8, pw: *u8, auth: u32)

extern "cyw43_arch_disable_ap_mode" cyw43_arch_disable_ap_mode()

// ### The rest
//
// The country the radio is configured for, as `CYW43_COUNTRY(a, b, rev)` packed it: two ASCII
// letters in the low bytes and a revision above them.
extern "cyw43_arch_get_country_code" cyw43_arch_get_country_code() -> u32

// Gives the driver a chance to run. **Required only by `pico_cyw43_arch_lwip_poll`**, where
// nothing else will; under `..._threadsafe_background` it is a no-op, which is what makes it safe
// to call unconditionally.
extern "cyw43_arch_poll" cyw43_arch_poll()

// ## C, through newlib
//
// The standard module binds this too, for `print`, but keeps it `private[sysl]` — and
// `sysl/sys/platform.sysl` says why: the link names stay free so that a program can declare them
// itself. This is a program doing exactly that, because echoing input works a character at a time and
// going through `prints` would build a string per keystroke.
extern "putchar" putchar(c: int) -> int
